# Local dev: copy to backend/.env and frontend/.env
# Docker: defaults are in docker-compose.yml
# Do not commit real secrets.

# --- backend/.env ---
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/comments_app
# PORT=3001
# JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
# JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars

# --- frontend/.env ---
# NEXT_PUBLIC_API_URL=http://localhost:3001
